        blueboat/multibeam_link:
          Value: true
        blueboat/right_thruster_link:
          Value: true
        blueboat/status_light_link:
          Value: true
        local_enu:
          Value: true
        world_enu:
          Value: true
        world_ned:
          Value: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        world_enu:
          blueboat/map:
            blueboat/base_link_enu:
              blueboat/base_link:
                blueboat/altimeter_link:
                  {}
                blueboat/base_link_urdf:
                  {}
                blueboat/camera_link:
                  {}
                blueboat/gps_frame:
                  {}
                blueboat/imu_link:
                  {}
                blueboat/left_thruster_link:
                  {}
                blueboat/lidar_front:
                  {}
                blueboat/multibeam_link:
                  {}
                blueboat/right_thruster_link:
                  {}
                blueboat/status_light_link:
                  {}
          local_enu:
            {}
        world_ned:
          {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /blueboat/robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
        blueboat/altimeter_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        blueboat/base_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        blueboat/base_link_enu:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        blueboat/gps_frame:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        blueboat/imu_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        blueboat/left_thruster_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        blueboat/lidar_front:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        blueboat/multibeam_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        blueboat/right_thruster_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        blueboat/status_light_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
      Mass Properties:
        Inertia: false
        Mass: false
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 0.699999988079071
      Blocks: 1
      Class: rviz_satellite/AerialMap
      Draw Behind: true
      Enabled: true
      Name: AerialMap
      Object URI: https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
      TF tolerance: 0.10000000149011612
      Timeout: 1e+08
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /world_ned_frame/gps
      Value: true
      Zoom: 20
